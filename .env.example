# Public site URL — only needed for a custom domain.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL automatically,
# and to http://localhost:3000 in local development.
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Contact form email delivery (required for the form to send).
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Optional overrides. Defaults: send to siteConfig.links.email, from Resend's
# shared onboarding@resend.dev sender (which only delivers to the address that
# owns the Resend account — replace it once you verify your own domain).
# CONTACT_TO_EMAIL=you@example.com
# CONTACT_FROM_EMAIL=Portfolio Contact <hello@yourdomain.com>

# Analytics (optional)
# NEXT_PUBLIC_ANALYTICS_ID=G-XXXXXXXXXX
